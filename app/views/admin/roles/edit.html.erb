<%= turbo_frame_tag "role_form" do %>
    <%= form_with(model: @role, url: admin_role_path, method: :patch, data: { action: 'drawer#close' }) do |f| %>
        <div class="mb-10">
            <h1 class="text-2xl antialiased font-semibold mt-4">Edit role</h1>
        </div>
        <%= render 'role', f: f %>
    <% end %>
<% end %>
