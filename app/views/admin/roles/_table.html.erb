<table class="table">
  <!-- head -->
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Created at</th>
      <th>Updated at</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="roles">
    <% roles.each do |role| %>
        <%= render 'table_row', role: role %>
    <% end %>
  </tbody>
</table>
