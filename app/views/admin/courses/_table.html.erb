<table class="table">
  <!-- head -->
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Grading type</th>
      <th>Created at</th>
      <th>Updated at</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="courses">
    <% courses.each do |course| %>
        <%= render 'table_row', course: course %>
    <% end %>
  </tbody>
</table>
